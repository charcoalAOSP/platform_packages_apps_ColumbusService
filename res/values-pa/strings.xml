    <!-- Items in Quick Tap gesture settings -->
    <string name="setting_enabled_title">ਕਵਿੱਕ ਟੈਪ ਵਰਤੋ</string>
    <string name="setting_sensitivity_category_title">ਕਵਿੱਕ ਟੈਪ ਦੀ ਤੀਬਰਤਾ</string>
    <string name="setting_low_sensitivity_title">ਮਜ਼ਬੂਤ ਟੈਪਾਂ ਦੀ ਲੋੜ ਹੈ</string>
    <string name="launch_settings_activity_title">ਕਵਿੱਕ ਟੈਪ ਸੈਟਿੰਗਾਂ</string>
    <string name="setting_action_title" product="default">ਇਸ ਦੇ ਲਈ ਫ਼ੋਨ ਦੇ ਪਿਛਲੇ ਪਾਸੇ ਦੋ ਵਾਰ ਟੈਪ ਕਰੋ</string>
    <string name="setting_app_selection_help_text" product="default">ਉਹ ਐਪ ਚੁਣੋ ਜਿਸਨੂੰ ਤੁਸੀਂ ਆਪਣੇ ਫ਼ੋਨ ਦੇ ਪਿਛਲੇ ਪਾਸੇ ਦੋ ਵਾਰ ਟੈਪ ਕਰ ਕੇ ਖੋਲ੍ਹਣਾ ਚਾਹੁੰਦੇ ਹੋ। ਜੇ ਤੁਸੀਂ ਐਪ ਨੂੰ ਅਣਸਥਾਪਤ ਕਰਦੇ ਹੋ, ਤਾਂ ਕਵਿੱਕ ਟੈਪ ਉਦੋਂ ਤੱਕ ਬੰਦ ਹੋ ਜਾਂਦਾ ਹੈ, ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਕੋਈ ਹੋਰ ਐਪ ਨਹੀਂ ਚੁਣਦੇ।</string>
    <string name="setting_app_shortcut_selection_help_text">ਚੁਣੋ ਕਿ ਜਦੋਂ ਤੁਸੀਂ ਕਵਿੱਕ ਟੈਪ ਦੀ ਵਰਤੋਂ ਨਾਲ ਇਸ ਐਪ ਨੂੰ ਖੋਲ੍ਹਦੇ ਹੋ ਤਾਂ ਕੀ ਹੁੰਦਾ ਹੈ।</string>
    <string name="radio_button_extra_widget_a11y_label"><xliff:g id="action">%1$s</xliff:g> ਸੈਟਿੰਗਾਂ</string>
    <string name="setting_action_launch_summary_no_selection">ਕੋਈ ਐਪ ਨਹੀਂ ਚੁਣੀ ਗਈ</string>
    <string name="setting_action_launch_summary_not_installed">ਐਪ ਸਥਾਪਤ ਨਹੀਂ ਕੀਤੀ ਗਈ</string>

