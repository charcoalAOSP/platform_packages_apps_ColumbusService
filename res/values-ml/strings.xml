    <!-- Entry points in Settings -->
    <string name="settings_entry_title">പ്രവർത്തനങ്ങൾ ആരംഭിക്കാൻ വേഗത്തിലുള്ള ടാപ്പ്</string>
    <string name="settings_entry_summary_on">ഓൺ / <xliff:g id="action" example="Take screenshot">%1$s</xliff:g></string>
    <string name="settings_entry_summary_off">ഓഫ്</string>

    <!-- Items in Quick Tap gesture settings -->
    <string name="setting_enabled_title">വേഗത്തിലുള്ള ടാപ്പ് ഉപയോഗിക്കുക</string>
    <string name="setting_sensitivity_category_title">വേഗത്തിലുള്ള ടാപ്പിന്റെ ശക്തി</string>
    <string name="setting_low_sensitivity_title">കൂടുതൽ ശക്തമായ ടാപ്പുകൾ ആവശ്യമാണ്</string>
    <string name="launch_settings_activity_title">"'വേഗത്തിലുള്ള ടാപ്പ്' ക്രമീകരണം"</string>
    <string name="setting_action_title" product="default">ഇനിപ്പറയുന്നതിനായി ഫോണിന്റെ പിൻഭാഗത്ത് രണ്ടുതവണ ടാപ്പ് ചെയ്യുക</string>
    <string name="setting_app_selection_help_text" product="default">നിങ്ങളുടെ ഫോണിന്റെ പിൻഭാഗത്ത് രണ്ടുതവണ ടാപ്പ് ചെയ്യുമ്പോൾ തുറക്കാൻ ഒരു ആപ്പ് തിരഞ്ഞെടുക്കുക. നിങ്ങൾ ആപ്പ് അൺഇൻസ്‌റ്റാൾ ചെയ്യുകയാണെങ്കിൽ, മറ്റൊരു ആപ്പ് തിരഞ്ഞെടുക്കുന്നതുവരെ, വേഗത്തിലുള്ള ടാപ്പ് ഓഫാകും.</string>
    <string name="setting_app_shortcut_selection_help_text">വേഗത്തിലുള്ള ടാപ്പ് ഉപയോഗിച്ച് നിങ്ങൾ ഈ ആപ്പ് തുറക്കുമ്പോൾ എന്ത് സംഭവിക്കുന്നുവെന്ന് തിരഞ്ഞെടുക്കുക.</string>
    <string name="radio_button_extra_widget_a11y_label"><xliff:g id="action">%1$s</xliff:g> ക്രമീകരണം</string>
    <string name="setting_action_launch_summary_no_selection">ആപ്പുകളൊന്നും തിരഞ്ഞെടുത്തിട്ടില്ല</string>
    <string name="setting_action_launch_summary_not_installed">ആപ്പ് ഇൻസ്‌റ്റാൾ ചെയ്‌തിട്ടില്ല</string>

